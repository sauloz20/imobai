# Backend database connection. Use the exact MySQL/TLS URL provided by TiDB Cloud.
DATABASE_URL=mysql://USER:PASSWORD@HOST:4000/DATABASE?sslaccept=strict

# Number of database connections per Node.js process. Keep this low when scaling replicas.
DB_POOL_SIZE=10

NODE_ENV=development
PORT=3000

# Existing application secrets/integrations
JWT_SECRET=replace-with-a-long-random-secret
VITE_APP_ID=
OWNER_OPEN_ID=
OAUTH_SERVER_URL=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
HUGGINGFACE_API_KEY=
OPENROUTER_API_KEY=
